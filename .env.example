# Environment Configuration
ENV=development
DEBUG=true

# Database Configuration
# Supabase PostgreSQL (REQUIRED)
# Get connection string from: Supabase Dashboard → Settings → Database → Connection String → URI
# Replace [ref] with your project reference and [YOUR-PASSWORD] with your database password
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Application
SECRET_KEY=your-secret-key-here-change-in-production
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# AI Features (Future - for AI Consultant modes)
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp
# Note: Using Gemini 2.0 Flash Experimental for fast, cost-effective AI insights

# Data Ingestion
DATA_GOV_SG_API_URL=https://data.gov.sg/api/action/datastore_search
DATA_GOV_SG_RESOURCE_ID=d_8b84c4ee58e3cfc0ece0d773c8ca6abc
ONEMAP_API_URL=https://www.onemap.gov.sg/api/common/elastic/search

# OneMap Authentication - Choose ONE method:
# Method 1: Use pre-obtained token (recommended if email/password auth fails)
ONEMAP_API_TOKEN=your-onemap-api-token-here

# Method 2: Email/password authentication (auto-fetches token)
# ONEMAP_EMAIL=your-onemap-email-here
# ONEMAP_PASSWORD=your-onemap-password-here

# Ingestion Configuration
INGESTION_RETRY_COUNT=3
INGESTION_RETRY_DELAY_SECONDS=5

# Rate Limiting (prevents overwhelming external APIs)
# data.gov.sg - requests per minute (default: 60 = 1 per second)
DATA_GOV_SG_REQUESTS_PER_MINUTE=60

# Maximum records to ingest per run (0 = no limit, useful for testing)
# Set to smaller value (e.g., 10000) for initial testing
INGESTION_MAX_RECORDS=0


